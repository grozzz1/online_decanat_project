# Add these non-secret settings to .env if defaults need changing.
LOCAL_AI_ENABLED=1
LOCAL_AI_ENGINE=llamacpp
LOCAL_AI_URL=http://127.0.0.1:18081
LOCAL_AI_MODEL=qwen3-4b-instruct
LOCAL_AI_TIMEOUT=90
LOCAL_AI_QUEUE_TIMEOUT=5
LOCAL_AI_MAX_TOKENS=512
LOCAL_AI_CONTEXT_CHARS=12000
LOCAL_AI_COOLDOWN=30
# Optional: LOCAL_AI_MODEL_PATH=C:/path/to/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Additional local rules, separated with semicolons. Markdown, TXT and text PDFs:
# KNOWLEDGE_PATHS=C:/path/to/regulations;C:/path/to/additional-rules.md
