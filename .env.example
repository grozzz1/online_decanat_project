# Telegram: obtain BOT_TOKEN from @BotFather. Never commit the real .env.
BOT_TOKEN=replace_with_botfather_token
# Integer chat IDs: dean's group and a separate private administrative log group.
DEAN_CHAT_ID=-1000000000000
ADMIN_LOG_CHAT_ID=-1000000000001

# Optional. Empty = tools/tesseract/tesseract.exe, then tesseract from PATH.
TESSERACT_CMD=
# Optional debug images include document contents; keep this directory private.
DOCUMENT_CV_DEBUG_DIR=

# Local Qwen. 0 disables the fallback; OCR/Regex/CV/Python QA still work.
LOCAL_AI_ENABLED=1
LOCAL_AI_ENGINE=llamacpp
LOCAL_AI_URL=http://127.0.0.1:18081
LOCAL_AI_MODEL=qwen3-4b-instruct
LOCAL_AI_TIMEOUT=90
LOCAL_AI_QUEUE_TIMEOUT=5
LOCAL_AI_MAX_TOKENS=512
LOCAL_AI_CONTEXT_CHARS=12000
LOCAL_AI_COOLDOWN=30
# Optional absolute GGUF path; empty = models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf.
LOCAL_AI_MODEL_PATH=
# Optional additional local MD/TXT/text PDF files or directories, separated by ;.
KNOWLEDGE_PATHS=
